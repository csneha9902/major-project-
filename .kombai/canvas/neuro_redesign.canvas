      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Raleway:wght@300;400;600&family=Cinzel:wght@400;700&family=Space+Mono&display=swap');\n\n  :root {\n    --deep-blue: #3D4DB0;\n    --neon-cyan: #06d6a0;\n    --bg-white: #FFFFFF;\n    --chart-bg: #0a0e1a;\n  }\n\n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n\n  body {\n    background-color: var(--bg-white);\n    color: #333;\n    overflow-x: hidden;\n  }\n\n  .font-bodoni { font-family: 'Bodoni Moda', serif; }\n  .font-raleway { font-family: 'Raleway', sans-serif; }\n  .font-cinzel { font-family: 'Cinzel', serif; }\n  .font-mono { font-family: 'Space Mono', monospace; }\n\n  /* Hero Wave Background */\n  .hero-wave {\n    position: absolute;\n    top: -100px;\n    left: -10%;\n    width: 65%;\n    height: 1200px;\n    background: linear-gradient(135deg, var(--deep-blue) 0%, #1a237e 100%);\n    clip-path: ellipse(75% 100% at 0% 50%);\n    z-index: 0;\n    opacity: 1;\n  }\n\n  .hero-wave::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%);\n  }\n\n  /* Isometric System */\n  .iso-scene {\n    perspective: 2000px;\n    transform-style: preserve-3d;\n  }\n\n  .iso-platform {\n    position: absolute;\n    transform-style: preserve-3d;\n    transform: rotateX(60deg) rotateZ(-45deg);\n    transition: transform 0.5s ease-out;\n  }\n\n  .cube-face {\n    position: absolute;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .face-top {\n    background: #f8fbff;\n    box-shadow: inset 0 0 40px rgba(61, 77, 176, 0.05), 0 10px 30px rgba(0,0,0,0.05);\n  }\n\n  .face-front {\n    background: #3D4DB0;\n    filter: brightness(0.85);\n  }\n\n  .face-side {\n    background: #2D3A85;\n    filter: brightness(0.7);\n  }\n\n  /* Specific Platform Dimensions */\n  .platform-lg { width: 320px; height: 320px; }\n  .platform-md { width: 180px; height: 180px; }\n  .platform-sm { width: 100px; height: 100px; }\n\n  /* Floating Animation */\n  @keyframes float {\n    0%, 100% { transform: translateY(0px) rotateX(60deg) rotateZ(-45deg); }\n    50% { transform: translateY(-15px) rotateX(60deg) rotateZ(-45deg); }\n  }\n\n  .animate-float {\n    animation: float 4s ease-in-out infinite;\n  }\n\n  /* Stair System */\n  .stair-step {\n    position: absolute;\n    width: 60px;\n    height: 30px;\n    background: #f0f4ff;\n    border: 1px solid rgba(0,0,0,0.05);\n    transform: rotateX(60deg) rotateZ(-45deg);\n  }\n\n  /* Chart Styles */\n  .mesh-grid {\n    background-size: 40px 40px;\n    background-image: \n      linear-gradient(rgba(6, 214, 160, 0.2) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(6, 214, 160, 0.2) 1px, transparent 1px);\n    transform: perspective(1000px) rotateX(70deg) scale(2.5);\n    transform-origin: center bottom;\n  }\n\n  .glow-cyan { filter: drop-shadow(0 0 15px var(--neon-cyan)); }\n  .glow-yellow { filter: drop-shadow(0 0 15px #FADB5F); }\n  .glow-red { filter: drop-shadow(0 0 15px #E56B55); }\n\n  /* GSAP interaction classes */\n  .gsap-reveal { opacity: 0; transform: translateY(30px); }\n  .gsap-platform { transition: transform 0.1s linear; }\n\n  /* Pill Button */\n  .pill-button {\n    background: linear-gradient(135deg, #688EA3 0%, #3D4DB0 100%);\n    box-shadow: 0 10px 30px rgba(61, 77, 176, 0.3);\n  }\n</style>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\" data-kid=\"1\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\" data-kid=\"2\"></script>\n\n\n<nav class=\"fixed top-0 left-0 w-full px-16 py-10 flex justify-between items-center z-50 pointer-events-none\" data-kid=\"3\">\n  <div class=\"pointer-events-auto\" data-kid=\"3-0\">\n    <span class=\"font-cinzel text-2xl font-bold tracking-widest text-white mix-blend-difference\" data-kid=\"3-0-0\">NEURO</span>\n  </div>\n  <div class=\"flex gap-16 pointer-events-auto\" data-kid=\"3-1\">\n    <a href=\"#\" class=\"font-raleway text-xs font-bold tracking-[0.2em] text-slate-500 hover:text-blue-600 transition-colors uppercase\" data-kid=\"3-1-0\">Home</a>\n    <a href=\"#\" class=\"font-raleway text-xs font-bold tracking-[0.2em] text-slate-500 hover:text-blue-600 transition-colors uppercase\" data-kid=\"3-1-1\">About</a>\n    <a href=\"#\" class=\"font-raleway text-xs font-bold tracking-[0.2em] text-slate-500 hover:text-blue-600 transition-colors uppercase\" data-kid=\"3-1-2\">Team</a>\n    <a href=\"#\" class=\"font-raleway text-xs font-bold tracking-[0.2em] text-slate-500 hover:text-blue-600 transition-colors uppercase\" data-kid=\"3-1-3\">Info</a>\n  </div>\n</nav>\n\n\n<section class=\"relative w-full h-[1000px] overflow-hidden bg-white flex\" data-kid=\"4\">\n  <div class=\"hero-wave\" data-kid=\"4-0\"></div>\n  \n  \n  <div class=\"relative w-7/12 h-full iso-scene\" data-kid=\"4-1\">\n    \n    \n    <div class=\"iso-platform platform-lg animate-float\" style=\"top: 250px; left: 100px; animation-delay: -0.5s;\" data-kid=\"4-1-0\">\n      <div class=\"cube-face face-top w-full h-full p-6 flex items-center justify-center overflow-hidden\" data-kid=\"4-1-0-0\">\n        <img src=\"https://images.unsplash.com/photo-1698006150156-3779d5c2306c?auto=format&w=1200&q=80&fit=crop\" alt=\"Diagnostic Tech\" class=\"w-[120%] h-[120%] object-cover -translate-y-4\" decoding=\"async\" loading=\"lazy\" data-kid=\"4-1-0-0-0\">\n      </div>\n      <div class=\"cube-face face-front w-full h-[80px] translate-y-[240px] -rotate-x-90 translate-z-[40px] border-white/20\" data-kid=\"4-1-0-1\"></div>\n      <div class=\"cube-face face-side h-full w-[80px] translate-x-[280px] rotate-y-90 translate-z-[40px] border-white/20\" data-kid=\"4-1-0-2\"></div>\n    </div>\n\n    \n    <div class=\"iso-platform platform-md animate-float\" style=\"top: 120px; left: 480px; animation-delay: -2s;\" data-kid=\"4-1-1\">\n      <div class=\"cube-face face-top w-full h-full p-4 flex items-center justify-center overflow-hidden\" data-kid=\"4-1-1-0\">\n        <img src=\"https://images.unsplash.com/photo-1730303827725-6cc9143877e7?auto=format&w=800&q=80&fit=crop\" alt=\"Hologram\" class=\"w-[140%] h-[140%] object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"4-1-1-0-0\">\n      </div>\n      <div class=\"cube-face face-front w-full h-[60px] translate-y-[120px] -rotate-x-90 translate-z-[30px]\" data-kid=\"4-1-1-1\"></div>\n      <div class=\"cube-face face-side h-full w-[60px] translate-x-[150px] rotate-y-90 translate-z-[30px]\" data-kid=\"4-1-1-2\"></div>\n    </div>\n\n    \n    <div class=\"iso-platform platform-md animate-float\" style=\"top: 580px; left: 420px; animation-delay: -1.2s;\" data-kid=\"4-1-2\">\n      <div class=\"cube-face face-top w-full h-full p-4 flex items-center justify-center overflow-hidden\" data-kid=\"4-1-2-0\">\n        <img src=\"https://images.unsplash.com/photo-1659018966825-43297e655ccf?auto=format&w=800&q=80&fit=crop\" alt=\"Patient Care\" class=\"w-[130%] h-[130%] object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"4-1-2-0-0\">\n      </div>\n      <div class=\"cube-face face-front w-full h-[60px] translate-y-[120px] -rotate-x-90 translate-z-[30px]\" data-kid=\"4-1-2-1\"></div>\n      <div class=\"cube-face face-side h-full w-[60px] translate-x-[150px] rotate-y-90 translate-z-[30px]\" data-kid=\"4-1-2-2\"></div>\n    </div>\n\n    \n    <div class=\"absolute\" style=\"top: 300px; left: 420px; transform: rotateX(60deg) rotateZ(-45deg);\" data-kid=\"4-1-3\">\n       <div class=\"flex flex-col space-y-2\" data-kid=\"4-1-3-0\">\n         <div class=\"w-24 h-6 bg-slate-200 shadow-sm translate-z-[10px]\" data-kid=\"4-1-3-0-0\"></div>\n         <div class=\"w-24 h-6 bg-slate-100 shadow-sm translate-z-[20px] -translate-x-4\" data-kid=\"4-1-3-0-1\"></div>\n         <div class=\"w-24 h-6 bg-slate-50 shadow-sm translate-z-[30px] -translate-x-8\" data-kid=\"4-1-3-0-2\"></div>\n       </div>\n    </div>\n  </div>\n\n  \n  <div class=\"relative w-2/5 h-full flex flex-col justify-center items-end pr-32 text-right z-10\" data-kid=\"4-2\">\n    <div class=\"gsap-reveal mr-8\" data-kid=\"4-2-0\">\n      <h1 class=\"font-bodoni text-[84px] font-light text-blue-900 leading-[0.9] tracking-tight mb-10\" data-kid=\"4-2-0-0\">\n        Future medical<br data-kid=\"4-2-0-0-0\">technology\n      </h1>\n      <div class=\"flex justify-end mb-12\" data-kid=\"4-2-0-1\">\n        <div class=\"w-48 h-[1px] bg-blue-900/20\" data-kid=\"4-2-0-1-0\"></div>\n      </div>\n      <p class=\"font-raleway text-slate-500 max-w-sm mb-12 text-lg leading-relaxed\" data-kid=\"4-2-0-2\">\n        Integrating neural interfaces with real-time biometric scanning to redefine the boundaries of human potential and clinical precision.\n      </p>\n      <a href=\"#\" class=\"pill-button px-12 py-5 rounded-full text-white font-cinzel text-xs tracking-[0.3em] font-bold hover:scale-105 transition-transform inline-block\" data-kid=\"4-2-0-3\">\n        READ MORE\n      </a>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"relative w-full h-[900px] bg-[#0a0e1a] overflow-hidden flex flex-col font-raleway pt-20\" data-kid=\"5\">\n  \n  <div class=\"px-20 flex justify-between items-center z-30\" data-kid=\"5-0\">\n    <div class=\"flex items-center space-x-4\" data-kid=\"5-0-0\">\n      <div class=\"w-3 h-3 rounded-full bg-[#06d6a0] animate-ping\" data-kid=\"5-0-0-0\"></div>\n      <div class=\"flex flex-col\" data-kid=\"5-0-0-1\">\n        <span class=\"font-cinzel text-[10px] tracking-[0.4em] text-[#06d6a0]\" data-kid=\"5-0-0-1-0\">SYSTEM STATUS</span>\n        <span class=\"font-mono text-xs text-white opacity-40\" data-kid=\"5-0-0-1-1\">NOMINAL / SECTOR 04_X</span>\n      </div>\n    </div>\n    <div class=\"flex items-center space-x-12\" data-kid=\"5-0-1\">\n      <div class=\"flex flex-col items-end\" data-kid=\"5-0-1-0\">\n        <span class=\"font-mono text-[10px] text-white opacity-30\" data-kid=\"5-0-1-0-0\">CORE FREQUENCY</span>\n        <span class=\"font-mono text-sm text-[#06d6a0]\" data-kid=\"5-0-1-0-1\">2.84 GHZ</span>\n      </div>\n      <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"5-0-1-1\">\n      <i class=\"ti ti-activity-heartbeat text-[#06d6a0] text-4xl opacity-80\" data-kid=\"5-0-1-2\"></i>\n    </div>\n  </div>\n\n  \n  <div class=\"relative flex-1 flex flex-col justify-center px-20\" data-kid=\"5-1\">\n    \n    <i class=\"ti ti-crosshair absolute top-10 left-20 text-white/10 text-4xl\" data-kid=\"5-1-0\"></i>\n    <i class=\"ti ti-crosshair absolute bottom-10 left-20 text-white/10 text-4xl\" data-kid=\"5-1-1\"></i>\n    <i class=\"ti ti-crosshair absolute top-10 right-20 text-white/10 text-4xl\" data-kid=\"5-1-2\"></i>\n    <i class=\"ti ti-crosshair absolute bottom-10 right-20 text-white/10 text-4xl\" data-kid=\"5-1-3\"></i>\n\n    \n    <div class=\"absolute inset-0 z-0 overflow-hidden opacity-30 pointer-events-none\" data-kid=\"5-1-4\">\n      <div class=\"mesh-grid w-[150%] h-full absolute -left-[25%] -bottom-[30%]\" data-kid=\"5-1-4-0\"></div>\n    </div>\n\n    \n    <div class=\"relative w-full h-[500px] z-10 flex items-center\" data-kid=\"5-1-5\">\n      <svg class=\"w-full h-full\" viewBox=\"0 0 1200 500\" preserveAspectRatio=\"none\" data-kid=\"5-1-5-0\">\n        <defs data-kid=\"5-1-5-0-0\">\n          <linearGradient id=\"cyanGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\" data-kid=\"5-1-5-0-0-0\">\n            <stop offset=\"0%\" style=\"stop-color:rgba(6,214,160,0)\" data-kid=\"5-1-5-0-0-0-0\"></stop>\n            <stop offset=\"50%\" style=\"stop-color:rgba(6,214,160,1)\" data-kid=\"5-1-5-0-0-0-1\"></stop>\n            <stop offset=\"100%\" style=\"stop-color:rgba(6,214,160,0)\" data-kid=\"5-1-5-0-0-0-2\"></stop>\n          </linearGradient>\n        </defs>\n        \n        \n        <path d=\"M0,250 Q150,50 300,250 T600,250 T900,250 T1200,250\" fill=\"none\" stroke=\"#06d6a0\" stroke-width=\"5\" stroke-linecap=\"round\" class=\"glow-cyan\" data-kid=\"5-1-5-0-1\"></path>\n        \n        \n        <path d=\"M0,320 C100,150 200,450 300,320 S500,100 600,320 S800,550 900,320 S1100,150 1200,320\" fill=\"none\" stroke=\"#FADB5F\" stroke-width=\"4\" stroke-linecap=\"round\" class=\"glow-yellow\" data-kid=\"5-1-5-0-2\"></path>\n              \n        \n        <path d=\"M0,200 Q300,450 600,200 T1200,200\" fill=\"none\" stroke=\"#E56B55\" stroke-width=\"5\" stroke-linecap=\"round\" class=\"glow-red opacity-80\" data-kid=\"5-1-5-0-3\"></path>\n      </svg>\n      \n      \n      <div class=\"absolute right-0 top-0 h-full flex flex-col justify-between py-10\" data-kid=\"5-1-5-1\">\n        <span class=\"font-mono text-xs text-[#06d6a0] opacity-80\" data-kid=\"5-1-5-1-0\">180.20</span>\n        <span class=\"font-mono text-xs text-[#06d6a0] opacity-80\" data-kid=\"5-1-5-1-1\">144.15</span>\n        <span class=\"font-mono text-xs text-[#06d6a0] opacity-80\" data-kid=\"5-1-5-1-2\">110.00</span>\n        <span class=\"font-mono text-xs text-[#06d6a0] opacity-80\" data-kid=\"5-1-5-1-3\">085.42</span>\n        <span class=\"font-mono text-xs text-[#06d6a0] opacity-80\" data-kid=\"5-1-5-1-4\">062.11</span>\n        <span class=\"font-mono text-xs text-[#06d6a0] opacity-80\" data-kid=\"5-1-5-1-5\">038.90</span>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"px-20 pb-20 flex justify-between items-end z-30\" data-kid=\"5-2\">\n    <div class=\"flex space-x-16\" data-kid=\"5-2-0\">\n      <div class=\"flex items-center space-x-3\" data-kid=\"5-2-0-0\">\n        <div class=\"w-2 h-2 rounded-full bg-[#06d6a0]\" data-kid=\"5-2-0-0-0\"></div>\n        <span class=\"font-cinzel text-[10px] tracking-[0.2em] text-white/50 uppercase\" data-kid=\"5-2-0-0-1\">Neural Stream</span>\n      </div>\n      <div class=\"flex items-center space-x-3\" data-kid=\"5-2-0-1\">\n        <div class=\"w-2 h-2 rounded-full bg-[#FADB5F]\" data-kid=\"5-2-0-1-0\"></div>\n        <span class=\"font-cinzel text-[10px] tracking-[0.2em] text-white/50 uppercase\" data-kid=\"5-2-0-1-1\">Synaptic Flux</span>\n      </div>\n      <div class=\"flex items-center space-x-3\" data-kid=\"5-2-0-2\">\n        <div class=\"w-2 h-2 rounded-full bg-[#E56B55]\" data-kid=\"5-2-0-2-0\"></div>\n        <span class=\"font-cinzel text-[10px] tracking-[0.2em] text-white/50 uppercase\" data-kid=\"5-2-0-2-1\">Biometric Core</span>\n      </div>\n    </div>\n    <div class=\"flex flex-col items-end\" data-kid=\"5-2-1\">\n      <div class=\"w-64 h-[1px] bg-white/10 mb-4\" data-kid=\"5-2-1-0\"></div>\n      <span class=\"font-mono text-[9px] text-white/20 tracking-widest uppercase\" data-kid=\"5-2-1-1\">Encryption Key: SHA-256_VRTX_99</span>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"relative w-full py-48 bg-white flex justify-center\" data-kid=\"6\">\n  <div class=\"max-w-7xl w-full grid grid-cols-3 gap-24 px-16\" data-kid=\"6-0\">\n    \n    <div class=\"group relative\" data-kid=\"6-0-0\">\n      <div class=\"absolute -top-12 -left-6 w-20 h-20 bg-linear-to-br from-[#3D4DB0] to-[#2D3A85] rounded-3xl flex items-center justify-center transform group-hover:-rotate-12 transition-transform duration-500 shadow-2xl z-10\" data-kid=\"6-0-0-0\">\n        <i class=\"ti ti-brain text-white text-3xl\" data-kid=\"6-0-0-0-0\"></i>\n      </div>\n      <div class=\"bg-white rounded-[40px] p-12 pt-20 text-left border border-slate-100 h-full shadow-[0_40px_100px_-20px_rgba(0,0,0,0.05)] hover:shadow-2xl transition-all duration-500\" data-kid=\"6-0-0-1\">\n        <h3 class=\"font-bodoni text-4xl font-light text-blue-950 mb-6 italic\" data-kid=\"6-0-0-1-0\">Neural Mapping</h3>\n        <p class=\"font-raleway text-slate-500 text-base leading-relaxed mb-8\" data-kid=\"6-0-0-1-1\">High-resolution topological mapping of synaptic activity for precise neurosurgical planning and cognitive recovery protocols.</p>\n        <div class=\"flex items-center text-blue-600 font-cinzel text-xs tracking-widest font-bold cursor-pointer hover:translate-x-2 transition-transform\" data-kid=\"6-0-0-1-2\">\n          DISCOVER <i class=\"ti ti-arrow-right ml-2\" data-kid=\"6-0-0-1-2-0\"></i>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"group relative mt-16\" data-kid=\"6-0-1\">\n      <div class=\"absolute -top-12 -left-6 w-20 h-20 bg-linear-to-br from-[#06d6a0] to-[#05b38a] rounded-3xl flex items-center justify-center transform group-hover:-rotate-12 transition-transform duration-500 shadow-2xl z-10\" data-kid=\"6-0-1-0\">\n        <i class=\"ti ti-microscope text-white text-3xl\" data-kid=\"6-0-1-0-0\"></i>\n      </div>\n      <div class=\"bg-white rounded-[40px] p-12 pt-16 text-left border border-slate-100 h-full shadow-[0_40px_100px_-20px_rgba(0,0,0,0.05)] hover:shadow-2xl transition-all duration-500\" data-kid=\"6-0-1-1\">\n        <h3 class=\"font-bodoni text-4xl font-light text-blue-950 mb-6 italic\" data-kid=\"6-0-1-1-0\">Nano-Scan</h3>\n        <p class=\"font-raleway text-slate-500 text-base leading-relaxed mb-8\" data-kid=\"6-0-1-1-1\">Molecular level scanning that identifies anomalies years before they manifest as clinical symptoms or physical degradation.</p>\n        <div class=\"flex items-center text-[#06d6a0] font-cinzel text-xs tracking-widest font-bold\" data-kid=\"6-0-1-1-2\">\n          DISCOVER <i class=\"ti ti-arrow-right ml-2\" data-kid=\"6-0-1-1-2-0\"></i>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"group relative mt-32\" data-kid=\"6-0-2\">\n      <div class=\"absolute -top-12 -left-6 w-20 h-20 bg-linear-to-br from-[#E56B55] to-[#c54b35] rounded-3xl flex items-center justify-center transform group-hover:-rotate-12 transition-transform duration-500 shadow-2xl z-10\" data-kid=\"6-0-2-0\">\n        <i class=\"ti ti-robot text-white text-3xl\" data-kid=\"6-0-2-0-0\"></i>\n      </div>\n      <div class=\"bg-white rounded-[40px] p-12 pt-16 text-left border border-slate-100 h-full shadow-[0_40px_100px_-20px_rgba(0,0,0,0.05)] hover:shadow-2xl transition-all duration-500\" data-kid=\"6-0-2-1\">\n        <h3 class=\"font-bodoni text-4xl font-light text-blue-950 mb-6 italic\" data-kid=\"6-0-2-1-0\">AI Synthesis</h3>\n        <p class=\"font-raleway text-slate-500 text-base leading-relaxed mb-8\" data-kid=\"6-0-2-1-1\">Autonomous surgical systems guided by real-time holographic data streams and quantum-accelerated decision mapping.</p>\n        <div class=\"flex items-center text-[#E56B55] font-cinzel text-xs tracking-widest font-bold\" data-kid=\"6-0-2-1-2\">\n          DISCOVER <i class=\"ti ti-arrow-right ml-2\" data-kid=\"6-0-2-1-2-0\"></i>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script data-kid=\"7\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Reveal hero text\n  gsap.from(\".gsap-reveal\", {\n    y: 50,\n    opacity: 0,\n    duration: 1.2,\n    ease: \"power4.out\",\n    delay: 0.5\n  });\n\n  // Animate platforms on scroll\n  gsap.utils.toArray(\".iso-platform\").forEach((platform, i) => {\n    gsap.to(platform, {\n      scrollTrigger: {\n        trigger: platform,\n        start: \"top bottom\",\n        end: \"bottom top\",\n        scrub: 1\n      },\n      y: (i % 2 === 0 ? -100 : 100),\n      rotationZ: (i % 2 === 0 ? -35 : -55),\n      ease: \"none\"\n    });\n  });\n\n  // Animate Chart Lines\n  gsap.from(\"path\", {\n    drawSVG: 0,\n    duration: 3,\n    ease: \"power2.inOut\",\n    stagger: 0.2,\n    scrollTrigger: {\n      trigger: \"svg\",\n      start: \"top 80%\"\n    }\n  });\n</script>",
